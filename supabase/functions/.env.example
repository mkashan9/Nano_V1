# Nano Edge Function environment (names only — no secrets)
# Copy to .env.local and fill values, or set them as Supabase Edge Function
# secrets. Never commit a filled copy.

VIDEO_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=

# Provider selection is not made here. The database decides which provider a
# request uses (`generation_providers.is_default`); these values only say how to
# reach the one it picked.

# MED-06: reaction clips are composed by json2video from companion art a
# reviewer has already approved. VIDEO_PROVIDER_API_KEY is the json2video API
# key; leave it empty and a clip is simply never made, which no learner notices
# because every reaction already has local art.
#
# The two below are overrides with working defaults:
#   VIDEO_PROVIDER_URL          the API base (default https://api.json2video.com)
#   VIDEO_COST_MICROS_PER_CLIP  estimated cost of one clip in millionths of a
#                               currency unit (default 15000). Correct this once
#                               a real invoice exists; a cost budget that reads
#                               zero for every clip never stops anything.
#
# VIDEO_PROVIDER_MODEL is unused by the compositor. It is still read by the
# superseded Veo adapter, which stays deployed so that switching the provider row
# back does not also need a redeploy.
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_MODEL=
VIDEO_COST_MICROS_PER_CLIP=

# MED-06: the Learning Guide's voice is Fish Audio. VOICE_PROVIDER_API_KEY is the
# Fish API key; leave it empty and narration is simply never recorded, which no
# learner notices because every line has a caption.
#
# The two below are overrides with working defaults:
#   VOICE_PROVIDER_URL   the API base (default https://api.fish.audio)
#   VOICE_PROVIDER_MODEL the TTS model (default s2.1-pro-free; Fish requires it
#                        as a header, and the valid values are s1, s2-pro,
#                        s2.1-pro, s2.1-pro-free)
VOICE_PROVIDER_URL=
VOICE_PROVIDER_MODEL=

# Optional. Fish bills by the size of the text and does not price a response, so
# this is arithmetic on a published rate. Left empty it defaults to 15000, which
# is roughly Fish's pay-as-you-go rate per thousand UTF-8 bytes.
VOICE_PROVIDER_COST_MICROS_PER_1K_CHARS=

# Optional Pollinations base (no secret required for basic usage)
# IMAGE_POLLINATIONS_BASE_URL=https://image.pollinations.ai
