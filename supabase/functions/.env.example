# Nano Edge Function environment (names only — no secrets)
# Copy to .env.local and fill values.

VIDEO_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=

# Provider selection (adapters decide routing)
IMAGE_PROVIDER=pollinations
VIDEO_PROVIDER=
VOICE_PROVIDER=

# MED-01: endpoint each configured adapter posts to. Empty means the adapter
# reports PROVIDER_UNCONFIGURED and the local fallback is used, which is the
# expected state until MED-04 (video) chooses a provider.
VIDEO_PROVIDER_URL=

# MED-03: the Learning Guide's voice is Gemini's Aoede. VOICE_PROVIDER_API_KEY is
# the Gemini API key; leave it empty and narration is simply never recorded, which
# no learner notices because every line has a caption.
#
# The two below are overrides with working defaults:
#   VOICE_PROVIDER_URL   the API base (default the public Gemini endpoint)
#   VOICE_PROVIDER_MODEL the speech model (default gemini-3.1-flash-tts-preview)
VOICE_PROVIDER_URL=
VOICE_PROVIDER_MODEL=

# Optional. Gemini prices speech by tokens and does not price a response, so cost
# budgets only bite if an operator supplies an estimate. Left empty, the daily
# request ceiling is the effective limit for voice.
VOICE_PROVIDER_COST_MICROS_PER_1K_CHARS=

# Optional Pollinations base (no secret required for basic usage)
# IMAGE_POLLINATIONS_BASE_URL=https://image.pollinations.ai
